# Security (key packages.security). `php bin/neo make:user` then `make:auth` configure a real login.
providers:
    # Where the users come from. With an entity (after make:user):
    # users:
    #     entity:
    #         class: App\Entity\User
    #         property: email
    users:
        memory:
            # e.g. admin: { password: '<hash from `php bin/neo security:hash-password`>', roles: [ROLE_ADMIN] }
            users: {}

password_hashers:
    # auto = best algorithm available (bcrypt / argon2), rehashed automatically on login
    default: auto

firewalls:
    # Public files: no security at all
    assets:
        pattern: ^/builds/
        security: false
    main:
        pattern: ^/
        provider: users
        form_login:
            login_path: /login
            enable_csrf: true
            # default_target_path: /dashboard
        logout:
            path: /logout
            # Page displayed after the logout
            target: /
            # A CSRF token is required and only POST is accepted: another site cannot log your users out.
            # In the templates: {{ logout_form('Logout') }} (a small form with a button)
            enable_csrf: true
            methods: [POST]
        remember_me:
            # "Remember me" checkbox (_remember_me): 604800 s = 7 days
            lifetime: 604800
            # database = one token per device in the remember_me_tokens table (revocable), signature = cookie only
            storage: database
        login_throttling:
            # Attempts per IP + identifier during interval seconds (5 x more per IP)
            max_attempts: 5
            interval: 60

role_hierarchy:
    ROLE_ADMIN: [ROLE_USER]

# Access rules, the first matching one is used, e.g.
# access_control:
#     - { path: ^/admin, roles: ROLE_ADMIN }
#     - { path: ^/account, roles: ROLE_USER }
access_control: []