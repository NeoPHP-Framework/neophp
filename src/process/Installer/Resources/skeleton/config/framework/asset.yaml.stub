# Assets (key framework.asset): files of assets/ compiled into public/builds/ and used with {{ asset('css/app.css') }}
source_path: '%kernel.root_path%/assets'
build_path: '%kernel.public_path%/builds'
# URL prefix of the compiled files; a CDN can be used, e.g. https://cdn.example.com/builds
public_url: /builds
# Compiles the changed files on each request (development); in production run `php bin/neo asset:reload --minify`
auto_compile: '%kernel.debug%'

# Hash added to the file names (cache busting): app.3f9c1a2b.css
hash:
    algorithm: xxh128
    length: 8