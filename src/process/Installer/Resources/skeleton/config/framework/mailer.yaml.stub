# Mailer (key framework.mailer): $this->sendEmail(...) / MailerInterface
# Transport, set MAILER_DSN in .env.local (smtp://user:password@smtp.example.com:587, file://default, null://null)
dsn: '%env(MAILER_DSN)%'

# Sender used when an email has no from()
from: '%env(APP_NAME)% <noreply@example.com>'

envelope:
  # Forces the envelope sender (bounces), ~ = the From address
  sender: ~
  # Redirects EVERY email to these addresses (MAILER_RECIPIENTS=me@example.com in development)
  recipients: '%env(csv:MAILER_RECIPIENTS)%'

# Headers added to every email, e.g. { X-App: shop }
headers: {}