#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Kernel;
use NeoPHP\Process\Console\ConsoleManagerInterface;
use NeoPHP\Process\Console\IO\Input;

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, 'The NeoPHP console must be run from the command line.' . PHP_EOL);
    exit(1);
}

require dirname(__DIR__) . '/vendor/autoload.php';

$kernel = new Kernel(Input::environment($argv));
$kernel->boot();

if (!$kernel->isEnabled(ConsoleManagerInterface::class)) {
    fwrite(STDERR, 'The Console process is disabled in config/config.php: enable NeoPHP\\Process\\Console\\ConsoleManager to use the command line.' . PHP_EOL);
    exit(1);
}

exit($kernel->getContainer()->get(ConsoleManagerInterface::class)->run($argv));