APP_NAME=NeoPHP
APP_ENV=dev
APP_DEBUG=1
APP_SECRET={{ app_secret }}

# Base URL used for absolute URLs outside of an HTTP request (console commands, emails sent from the console)
APP_URL=http://127.0.0.1:8000

# Reverse proxies whose X-Forwarded-* headers are trusted (comma separated IPs / CIDR), e.g. 127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
# Accepted host names (comma separated), e.g. example.com,*.example.com; empty = any host
TRUSTED_HOSTS=

# DATABASE_URL="mysql://user:password@127.0.0.1:3306/app?charset=utf8mb4"
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/app?charset=utf8"
DATABASE_URL="sqlite:///%kernel.root_path%/var/data.db"

# MAILER_DSN="smtp://user:password@smtp.example.com:587"
# MAILER_DSN="file://default"   (writes the emails in var/mails/)
MAILER_DSN="null://null"
# Redirects every email to these addresses (comma separated), e.g. in .env.local
MAILER_RECIPIENTS=

###> neo_ai ###
# NeoAI development assistant (active only when APP_DEBUG=1)
# Provider of the "default" connection: ollama, openai, anthropic, gemini, mistral, groq, openrouter, lmstudio, vllm, openai_compatible
NEO_AI_PROVIDER=ollama
NEO_AI_MODEL=qwen2.5-coder:7b
# Key and base URL of the "default" connection (empty = none / provider default), e.g. NEO_AI_API_KEY=${OPENAI_API_KEY}
NEO_AI_API_KEY=
NEO_AI_BASE_URL=
# Real keys go in .env.local (never commit them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OLLAMA_URL=http://localhost:11434
###< neo_ai ###