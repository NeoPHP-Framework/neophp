# =============================================================================
#  Environment variables of the application
# =============================================================================
#  Load order (the last one wins): .env  ->  .env.local  ->  .env.{APP_ENV}  ->  .env.{APP_ENV}.local
#  - .env        committed: default values for every developer, NO real secret here
#  - .env.local  NOT committed (.gitignore): your machine / the server (passwords, API keys)
#  Real environment variables of the server always win over these files.
#  Used in config/**/*.yaml with '%env(NAME)%' ('%env(bool:NAME)%', '%env(int:NAME)%', '%env(csv:NAME)%').
# =============================================================================

###> application ###
# Name displayed in the profiler, the emails and the OpenAPI documentation
APP_NAME=NeoPHP
# dev = development, prod = production, test = automated tests
APP_ENV=dev
# 1 = detailed errors, profiler toolbar, NeoAI, templates recompiled; ALWAYS 0 in production
APP_DEBUG=1
# Random secret (64 hex characters) signing cookies, CSRF, remember-me and cache entries.
# Generated by `neo install`; use another value in production (.env.local), e.g. php -r "echo bin2hex(random_bytes(32));"
APP_SECRET={{ app_secret }}
# Base URL used for absolute URLs outside of an HTTP request (console commands, emails sent from the console)
APP_URL=http://127.0.0.1:8000
###< application ###

###> http ###
# Reverse proxies (Nginx, load balancer, Cloudflare...) whose X-Forwarded-* headers are trusted: comma separated IPs / CIDR.
# Empty = the application is reached directly. e.g. TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
# Accepted host names (comma separated); empty = any host (set it in production). e.g. TRUSTED_HOSTS=example.com,*.example.com
TRUSTED_HOSTS=
###< http ###

###> database ###
# Connection of the Database component and the ORM. Special characters of the password must be URL encoded (@ -> %40).
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/app?charset=utf8mb4"
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/app?charset=utf8"
DATABASE_URL="sqlite:///%kernel.root_path%/var/data.db"
###< database ###

###> mailer ###
# How emails are sent:
# MAILER_DSN="smtp://user:password@smtp.example.com:587"   (SMTP with STARTTLS)
# MAILER_DSN="smtps://user:password@smtp.example.com:465"  (SMTP over SSL)
# MAILER_DSN="file://default"                               (writes the emails in var/mails/, handy in development)
MAILER_DSN="null://null"
# Redirects every email to these addresses (comma separated), e.g. in .env.local: MAILER_RECIPIENTS=me@example.com
MAILER_RECIPIENTS=
###< mailer ###

###> neo_ai ###
# NeoAI development assistant (active only when APP_DEBUG=1), see config/packages/neo_ai.yaml
# Provider of the "default" connection: ollama, openai, anthropic, gemini, mistral, groq, openrouter, lmstudio, vllm, openai_compatible
# Examples (in .env.local):
#   Gemini (free tier):  NEO_AI_PROVIDER=gemini     NEO_AI_MODEL=gemini-3.8-flash  NEO_AI_API_KEY=${GEMINI_API_KEY}
#   OpenAI:              NEO_AI_PROVIDER=openai     NEO_AI_MODEL=gpt-5.4-mini      NEO_AI_API_KEY=${OPENAI_API_KEY}
#   Anthropic:           NEO_AI_PROVIDER=anthropic  NEO_AI_MODEL=claude-sonnet-5   NEO_AI_API_KEY=${ANTHROPIC_API_KEY}
#   Ollama (local):      NEO_AI_PROVIDER=ollama     NEO_AI_MODEL=qwen2.5-coder:7b  (no key; qwen2.5-coder:3b on CPU)
NEO_AI_PROVIDER=ollama
NEO_AI_MODEL=qwen2.5-coder:7b
# Key and base URL of the "default" connection (empty = none / provider default)
NEO_AI_API_KEY=
NEO_AI_BASE_URL=
# API keys of the named connections: put the real values in .env.local, never in .env
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OLLAMA_URL=http://localhost:11434
###< neo_ai ###

###> queue ###
# QUEUE_DSN="filesystem://%kernel.root_path%/var/queue"
# QUEUE_DSN="redis://127.0.0.1:6379/0"   (requires ext-redis)
# QUEUE_DSN="sync://"                     (handles the messages immediately)
QUEUE_DSN="database://default"
###< queue ###