body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: #f6f7f9;
    color: #1d2433;
}

main {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
}

h1 {
    color: #3b1f6e;
}

code {
    background: #eceef2;
    padding: .15rem .4rem;
    border-radius: 4px;
}